{
  "name": "address-services",
  "version": "1.0.0",
  "description": "Türkiye il / ilçe / mahalle verisini (isim, nüfus, sınır geometrisi) sunan bağımsız GeoJSON servisi",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "analyze": "bun scripts/analyze-data.ts",
    "import:postgis": "bun scripts/import-postgis.ts",
    "init:env": "bun scripts/init-env.ts",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f api",
    "docker:reimport": "docker compose run --rm importer bun scripts/import-postgis.ts --reset"
  },
  "dependencies": {
    "@elysiajs/swagger": "^1.3.0",
    "elysia": "^1.3.0",
    "pino": "^9.5.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.6.0"
  }
}
