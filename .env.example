# ============================================================================
# address-services — ortam değişkenleri
# Kullanım:  bun run init:env   (rastgele şifre/anahtarla .env üretir, var olanı ezmez)
#      ya da: copy .env.example .env  ve "change_me" değerlerini değiştirin
# Not: Satır sonu yorumu kullanılmaz; yorumlar ayrı satırdadır.
# ============================================================================

# ---------- Docker Compose (db, importer, api) ----------
DB_USER=address
DB_PASSWORD=DB_pass_change
LOG_RETENTION_DAYS=30
DB_NAME=address
# Veritabanına ana makineden erişim portu (yalnızca 127.0.0.1'e açılır)
DB_PORT=5433
# api servisinin ana makinedeki portu
APP_PORT=3000
# Virgülle ayrılmış API anahtarları. Docker'da (production) her biri en az 24 karakter olmalı.
API_KEYS=change_me_api_key_0123456789abcdef
LOG_LEVEL=info

# ---------- Yerelde çalıştırma (bun run dev) ----------
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
API_KEY_HEADER=x-api-key
# geojson: veri dosyalardan belleğe yüklenir | postgis: veri PostgreSQL/PostGIS'ten okunur
REPOSITORY_DRIVER=geojson
# Yerelden docker'daki veritabanına bağlanmak için (DB_PASSWORD ile aynı şifre, DB_PORT ile aynı port)
DATABASE_URL=postgres://address:DB_pass_change@127.0.0.1:5433/address
DB_POOL_MAX=10

# ---------- Veri dosyaları (geojson sürücüsü ve içe aktarma) ----------
# Bu klasörde kökte ve/veya alt klasörlerde (1, 2, ... 70) aşağıdaki üç dosya aranır
DATA_DIR=./data
PROVINCE_FILE=il.geojson
DISTRICT_FILE=ilce.geojson
NEIGHBORHOOD_FILE=mahalle.geojson

# ---------- Cache ve arayüz ----------
CACHE_MAX_AGE_SECONDS=86400
GZIP_CACHE_MB=64
SWAGGER_ENABLED=true
SWAGGER_PATH=/swagger
DEMO_ENABLED=true
